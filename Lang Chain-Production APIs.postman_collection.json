    {
      "name": "Rate Limit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const i = pm.info.iteration + 1;\r\nconst status = pm.response.code;\r\n\r\nif (status === 200) {\r\n    console.log(`Request ${i}: ${status} OK`);\r\n} else if (status === 429) {\r\n    console.log(`Request ${i}: ${status} RATE LIMITED`);\r\n} else {\r\n    console.log(`Request ${i}: ${status}`);\r\n}\r\n\r\npm.test(`Request ${i}: Expected 200 or 429`, function () {\r\n    pm.expect(status).to.be.oneOf([200, 429]);\r\n});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const i = pm.info.iteration + 1;\r\n\r\npm.variables.set(\"requestNumber\", i);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"message\": \"Rate limit test {{requestNumber}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8000/chat",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "chat"
          ]
        }
      },
